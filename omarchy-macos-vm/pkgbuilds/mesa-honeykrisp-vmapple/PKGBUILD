# mesa-honeykrisp-vmapple: a private Honeykrisp (Asahi Vulkan) driver for
# reims-vgpu, never the desktop's: Mesa 26.2.6 plus aquarat's two 16-bit
# varying fixes and omvm's VK_EXT_fragment_shader_interlock patch, as one diff
# taken from the tree the owner's VMs run (~/src/mesa-honeykrisp-sb). Two ICDs under /usr/lib/mesa-honeykrisp-vmapple:
# headless/ (-Dplatforms=, what remote-mode VMs use) and wayland/ (local
# mode's window). Nothing goes into /usr/share/vulkan/icd.d, so only processes
# given VK_DRIVER_FILES (omvm's VMs) load it. MIT, as Mesa.

pkgname=mesa-honeykrisp-vmapple
pkgver=26.2.6
pkgrel=1
pkgdesc="Patched Honeykrisp Vulkan driver for omvm's macOS guest GPU (private prefix)"
arch=('aarch64')
url="https://github.com/sapoepsilon/omvm"
license=('MIT')
depends=(libdrm libelf llvm-libs zstd expat wayland libxshmfence spirv-tools)
makedepends=(git meson ninja python-mako python-yaml python-packaging glslang clang llvm
             wayland-protocols libclc spirv-llvm-translator)
options=('!lto')
source=("mesa::git+https://gitlab.freedesktop.org/mesa/mesa.git#tag=mesa-$pkgver"
        honeykrisp-vmapple.patch)
sha256sums=('SKIP'
            '866cba2fd923c89fe3b295222d279c37e4944c6390b03ac7ee32acaaa1a31b2a')
_prefix=/usr/lib/mesa-honeykrisp-vmapple

prepare() {
  git -C mesa apply --index ../honeykrisp-vmapple.patch
}

_setup() {
  meson setup "build-$1" mesa --prefix="$_prefix/$1" --buildtype=release -Db_ndebug=true \
    -Dvulkan-drivers=asahi -Dgallium-drivers= -Dplatforms="$2" -Dglx=disabled -Degl=disabled \
    -Dgbm=disabled -Dopengl=false -Dgles1=disabled -Dgles2=disabled -Dllvm=enabled \
    -Dvideo-codecs= -Dtools=
}

build() {
  _setup headless ''
  _setup wayland wayland
  ninja -C build-headless
  ninja -C build-wayland
}

package() {
  DESTDIR="$pkgdir" ninja -C build-headless install
  DESTDIR="$pkgdir" ninja -C build-wayland install
  install -Dm644 mesa/docs/license.rst "$pkgdir/usr/share/licenses/$pkgname/license.rst"
}
