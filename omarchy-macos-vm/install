#!/bin/bash
# Stage the macOS VM first-boot hook into DESTDIR; enables nothing.
set -euo pipefail
cd -- "$(dirname -- "${BASH_SOURCE[0]}")"
destination=${1:?Usage: ./install DESTDIR}
[[ $destination == /* && $destination != "/" ]] || { echo "Use an absolute staging directory" >&2; exit 1; }
for file in bin/*; do install -Dm755 "$file" "$destination/usr/lib/omarchy-macos-vm/${file##*/}"; done
while IFS= read -r -d '' file; do
  if [[ $file == */dispatcher.d/* ]]; then
    install -Dm755 "$file" "$destination/${file#files/}"
  else
    install -Dm644 "$file" "$destination/${file#files/}"
  fi
done < <(find files -type f -print0)
install -Dm755 cli/omarchy-macos-vm "$destination/usr/bin/omarchy-macos-vm"
install -Dm644 LICENSE "$destination/usr/share/licenses/omarchy-macos-vm/LICENSE"
