#!/bin/bash

# omarchy:summary=Install, launch, stop, inspect, or remove the macOS VM (Apple Silicon M1/M2)
# omarchy:args=<install|remove|launch|stop|status|create|progress> [options]

# Shipped by the omarchy-macos-vm package (omarchy-mac-pkgs macos-vm) as
# /usr/bin/omarchy-macos-vm, so images built on stock Omarchy have it; the copy
# in omarchy-mac's macos-vm branch is where it started.
#
# The counterpart of omarchy-windows-vm for Apple Silicon. The macOS VM stack is
# omvm (github.com/sapoepsilon/omvm): a side kernel with KVM for macOS guests,
# the vmapple QEMU, a patched Honeykrisp and the omvm tool, from
# omarchy-mac-pkgs's omarchy-macos-vm. The guest itself needs one boot into
# macOS (the developer installer's "Set up a macOS VM" tick does it before the
# first boot; otherwise omvm's run-on-macos.sh, the one-time macOS step):
# Apple's Virtualization framework restores it onto the VMXFER partition.
# Everything after that is automated: create (ingest -> setup -> virt) runs
# from install when the restored VM is already on VMXFER, and otherwise at
# each Omarchy login until it exists (omarchy-macos-vm-create.service, in the
# omarchy-macos-vm package, runs `create --auto` in the background). setup
# needs the side kernel; omarchy-macos-vm-boot-default keeps linux-aurora-vmapple
# as the persistent default Limine entry (with stock linux-aurora selectable for
# recovery), so all that is left to the owner is one restart.

set -uo pipefail

marker=${OMARCHY_MACOS_VM_MARKER:-/etc/omarchy/macos-vm.enabled}
state_dir=${OMARCHY_MACOS_VM_STATE:-/var/lib/omarchy/macos-vm}
user_state=${XDG_STATE_HOME:-$HOME/.local/state}/omarchy-macos-vm
config_file=${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/macos-vm.conf
# The macOS account's name and password, for the owner (0600, like
# omarchy-windows-vm's ~/.config/windows/credentials): the install wizard, the
# installer (handed over by omarchy-macos-vm-credentials) or the defaults below.
credentials_file=${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/macos-vm-credentials
# Like the Windows VM's "admin": what a blank password field means. The username
# defaults to this Omarchy user's name.
DEFAULT_PASSWORD=macos
omvm_cfg=${XDG_CONFIG_HOME:-$HOME/.config}/omvm/gui.env
omvm_data=${OMVM_DATA:-${XDG_DATA_HOME:-$HOME/.local/share}/omvm}
omvm_images=${OMVM_IMAGES:-$omvm_data/images}
stack=(omvm qemu-vmapple mesa-honeykrisp-vmapple linux-aurora-vmapple)
side_kernel=linux-aurora-vmapple
desktop_file=${XDG_DATA_HOME:-$HOME/.local/share}/applications/macos-vm.desktop
vm_name=${OMVM_VM:-macos}
# The side kernel exposes this KVM parameter; omvm setup needs it booted.
side_kernel_param=${OMARCHY_MACOS_VM_KVM_PARAM:-/sys/module/kvm/parameters/emulate_nisv_ldst}
boot_default_helper=${OMARCHY_MACOS_VM_BOOT_DEFAULT:-/usr/lib/omarchy-macos-vm/omarchy-macos-vm-boot-default}
default_side_kernel=${OMARCHY_MAC_DEFAULT_SIDE_KERNEL:-/etc/omarchy-mac-boot/default-side-kernel}
# The macOS restore makes a fixed 160 GB guest disk (sparse). The images, the
# Xcode disk image and the setup layers need about this much free space.
REQUIRED_SPACE_GB=${OMARCHY_MACOS_VM_REQUIRED_GB:-80}
VIRSH=(virsh -q -c qemu:///session)
# What create is doing (stage, percent, detail) and its output, for the progress view.
progress_file=$user_state/progress
stages_file=$user_state/stages
create_log=$user_state/create.log
creating_unit=omarchy-macos-vm-creating
progress_pid=${XDG_RUNTIME_DIR:-/tmp}/omarchy-macos-vm-progress.pid
# Apple Account / iMessage in the guest (omvm docs/apple-services.md): the
# owner's SEP identity and helper builds come from another install on this Mac
# (`apple-services import`); with them here, create enrolls the new VM.
apple_helper=${OMARCHY_MACOS_VM_APPLE_HELPER:-/usr/lib/omarchy-macos-vm/omarchy-macos-vm-apple-services}
apple_provider=${XDG_CONFIG_HOME:-$HOME/.config}/omvm/apple-services/identity-provider.json
apple_qemu=${OMVM_APPLE_QEMU:-/usr/lib/omvm-apple-services/qemu-system-aarch64}
apple_sep_conf=${OMARCHY_MACOS_VM_APPLE_SEP_CONF:-/etc/omvm/sep-identity.conf}
apple_template=${OMARCHY_MACOS_VM_APPLE_TEMPLATE:-/etc/omvm/apple-helpers.template.json}
request_apple_services=0

show_usage() {
  cat <<'USAGE'
Usage: omarchy-macos-vm [command] [options]

Commands:
  install [--apple-services]
                       Install the macOS VM stack and configure the VM
  remove [--purge]     Remove the macOS VM and the stack (--purge also deletes guest images)
  launch [options]     Start macOS VM (if needed) and open its window
                       Options:
                         --keep-alive, -k   Keep VM running after its window closes
  stop                 Stop the running macOS VM
  status               Show current VM status
  create [--auto] [--apple-services]
                       Finish the VM after the macOS step (ingest, setup, virt);
                       --auto picks the account, RAM and cores without asking;
                       --apple-services requires Apple Account / iMessage enrollment
  progress             Follow the setup (stage, percent, log) until it is done
  apple-services import SRC|old-root [--os-uuid UUID] [--qemu PATH]
                       Bring the SEP identity and Apple helpers (Apple Account,
                       iMessage) over from another Linux install on this Mac;
                       old-root opens the other Omarchy install here read-only
  apple-services enable
                       Enroll the VM with them (restarts it)
  apple-services status
  help                 Show this help message

Examples:
  omarchy-macos-vm install           # Set up macOS VM for first time
  omarchy-macos-vm launch            # Open the VM (auto-stop on exit)
  omarchy-macos-vm launch -k         # Open the VM (keep running)
  omarchy-macos-vm stop              # Shut down the VM
USAGE
}

# --- helpers -----------------------------------------------------------------

# M1 and M2 only: later Macs lock the PAuth registers a macOS guest needs.
supported_mac() {
  if command -v omarchy-hw-apple >/dev/null; then omarchy-hw-apple || return 1; fi
  grep -Eaq 'apple,(t8103|t6000|t6001|t6002|t8112|t6020|t6021|t6022)' "${OMARCHY_APPLE_COMPATIBLE:-/proc/device-tree/compatible}"
}

# At login the notification daemon (Omarchy's shell) can start after us: wait
# for it up to OMARCHY_MACOS_VM_NOTIFY_WAIT seconds, then fall back to
# notify-send (which drops --exec) and the journal.
notify_daemon_up() { busctl --user status org.freedesktop.Notifications >/dev/null 2>&1; }
notify() {
  local i wait=${OMARCHY_MACOS_VM_NOTIFY_WAIT:-90}
  for ((i = 0; i < wait; i += 2)); do notify_daemon_up && break; sleep 2; done
  omarchy-notification-send "$@" 2>/dev/null && return 0
  local args=() a
  for a in "$@"; do [[ $a == --exec ]] && break; args+=("$a"); done
  notify-send "${args[@]}" 2>/dev/null || true
  echo "notification: ${args[*]}" >&2
}

valid_ram() { [[ $1 =~ ^[0-9]{1,3}G$ ]] && ((10#${1%G} >= 4)); }
valid_cores() { [[ $1 =~ ^[0-9]{1,2}$ ]] && ((10#$1 >= 1)); }
valid_account() { [[ $1 =~ ^[a-z_][a-z0-9_-]{0,30}$ ]]; }
# omvm types the password inside single quotes on the guest's console: no '.
valid_password() { [[ $1 =~ ^[[:print:]]{1,64}$ && $1 != *"'"* ]]; }

# KEY [DEFAULT]: a setting from the macOS VM config (RAM_GIB, CPUS).
setting() {
  local value
  value=$(sed -n "s/^$1=//p" "$config_file" 2>/dev/null | tail -1)
  printf '%s\n' "${value:-${2:-}}"
}

save_settings() {
  local apple_flag=${3:-$(setting APPLE_SERVICES 0)}
  mkdir -p "${config_file%/*}" &&
    {
      printf '# omarchy-macos-vm install: what omvm virt %s is defined with\nRAM_GIB=%s\nCPUS=%s\n' \
        "$vm_name" "$1" "$2"
      [[ $apple_flag == 1 ]] && printf 'APPLE_SERVICES=1\n' || true
    } >"$config_file"
}

# omvm reads OMVM_GUEST_USER from its gui.env; set it, keeping every other line.
save_guest_user() {
  local tmp
  mkdir -p "${omvm_cfg%/*}" && touch "$omvm_cfg" || return 1
  tmp=$(mktemp "$omvm_cfg.XXXXXX") || return 1
  { grep -v '^OMVM_GUEST_USER=' "$omvm_cfg"; echo "OMVM_GUEST_USER=$1"; } >"$tmp" && mv "$tmp" "$omvm_cfg"
}

guest_user() { sed -n 's/^OMVM_GUEST_USER=//p' "$omvm_cfg" 2>/dev/null | tail -1; }

# omvm setup creates the guest account (image -v0) with the password in this
# file (generating one when it is missing) and logs it in automatically.
omvm_password_file=$omvm_data/guest-password
account_created() { compgen -G "$omvm_images/*-v0" >/dev/null; }

# USER PASSWORD: keep them for the owner, 0600 (a temp file, then one rename).
write_credentials() {
  local dir=${credentials_file%/*} tmp
  mkdir -p "$dir" || return 1
  tmp=$(umask 077 && mktemp "$dir/.macos-vm-credentials.XXXXXX") || return 1
  if ! printf 'USERNAME=%s\nPASSWORD=%s\n' "$1" "$2" >"$tmp" || ! chmod 0600 "$tmp" ||
    ! mv -f -- "$tmp" "$credentials_file"; then
    rm -f -- "$tmp"
    return 1
  fi
}

# KEY: USERNAME or PASSWORD from the credentials file; the first = splits, so a
# password may contain =.
read_credential() {
  local key value
  [[ -f $credentials_file ]] || return 1
  while IFS='=' read -r key value; do
    [[ $key == "$1" ]] && { printf '%s' "$value"; return 0; }
  done <"$credentials_file"
  return 1
}

# Hand the stored account to omvm before omvm setup creates it: the name in
# gui.env, the password in omvm's guest-password (0600).
apply_credentials() {
  local user password
  user=$(read_credential USERNAME) && password=$(read_credential PASSWORD) || return 1
  save_guest_user "$user" || return 1
  mkdir -p "$omvm_data" && (umask 077 && printf '%s\n' "$password" >"$omvm_password_file") &&
    chmod 0600 "$omvm_password_file"
}

# The account to show (status, the Ready screen): the stored one, else what an
# older setup left (gui.env and omvm's generated guest-password).
shown_username() { read_credential USERNAME || guest_user; }
shown_password() { read_credential PASSWORD || head -1 "$omvm_password_file" 2>/dev/null; }
credential_lines() {
  printf 'Username:  %s\n' "$(shown_username)"
  printf 'Password:  %s\n' "$(shown_password)"
}

# The installer chose the account, but omarchy-macos-vm-credentials (root) has
# not handed it over yet: wait for it rather than make the account with defaults.
credentials_pending() { [[ -e $state_dir/credentials-pending && ! -s $credentials_file ]]; }
bundle_ingested() { compgen -G "$omvm_images/*-restore/.ingested" >/dev/null; }
# The omarchy-macos-vm-vmxfer.service (root, at boot or on demand) looks on
# VMXFER for the macOS step's output and leaves this stamp when it is there.
vmxfer_ready() { [[ -e $state_dir/vmxfer-ready ]]; }
on_side_kernel() { [[ -e $side_kernel_param ]]; }
# omarchy-macos-vm-vmxfer.service keeps VMXFER mounted read-only here, so
# omvm ingest needs no sudo password.
vmxfer_mount() { sed -n 's/^mount=//p' "$state_dir/vmxfer-ready" 2>/dev/null | tail -1; }
side_kernel_default() { [[ -f $default_side_kernel ]] && grep -Fxq "$side_kernel" "$default_side_kernel" 2>/dev/null; }

# --- progress & readiness ----------------------------------------------------

# STAGE PERCENT DETAIL [FAILED_STAGE]: what create is doing now.
set_progress() {
  local stage=$1 percent=$2 detail=$3 failed_stage=${4:-} tier
  tier=$(active_tier)
  mkdir -p "$user_state" &&
    {
      printf 'stage=%s\npercent=%s\ndetail=%s\ntier=%s\n' "$stage" "$percent" "$detail" "$tier"
      [[ -n $failed_stage ]] && printf 'failed_stage=%s\n' "$failed_stage"
      printf 'updated=%s\n' "$(date -u +%FT%TZ)"
    } >"$progress_file.new" &&
    mv -f "$progress_file.new" "$progress_file" || {
    rm -f "$progress_file.new"
    return 1
  }
}
progress_value() { sed -n "s/^$1=//p" "$progress_file" 2>/dev/null | tail -1; }

# Explicit per-stage outcome tracking (ok, failed, skipped, waiting, restart-needed, not-requested).
set_stage_outcome() {
  local stage=$1 outcome=$2 tmp
  mkdir -p "$user_state" || return 1
  tmp=$(mktemp "$user_state/.stages.XXXXXX") || return 1
  {
    [[ -f $stages_file ]] && grep -v "^$stage=" "$stages_file" || true
    printf '%s=%s\n' "$stage" "$outcome"
  } >"$tmp" && mv -f "$tmp" "$stages_file" || {
    rm -f "$tmp"
    return 1
  }
}
stage_outcome() { sed -n "s/^$1=//p" "$stages_file" 2>/dev/null | tail -1; }
reset_stages() { mkdir -p "$user_state" && : >"$stages_file"; }

# The system setup's stage (omarchy-macos-vm-setup writes it): waiting-for-internet, installing, ...
system_stage() { sed -n 's/^stage=//p' "$state_dir/status" 2>/dev/null | tail -1; }
system_failed_stage() { sed -n 's/^failed_stage=//p' "$state_dir/status" 2>/dev/null | tail -1; }
creating() { systemctl --user is-active --quiet "$creating_unit.service" 2>/dev/null; }

stage_name() {
  case $1 in
  waiting-for-internet) echo "Waiting for internet" ;;
  installing | retrying | checking-boot | host-setup | staging-macos-step) echo "Installing the macOS VM stack" ;;
  importing) echo "Importing" ;;
  restart-needed) echo "Restart needed" ;;
  setting-up) echo "Setting up" ;;
  ready) echo "Ready" ;;
  failed) echo "Failed" ;;
  *) echo "$1" ;;
  esac
}

# The setup still running, as "STAGE PERCENT" (percent may be empty); nothing when idle.
in_progress() {
  local stage
  if [[ ! -e $state_dir/done ]]; then
    stage=$(system_stage)
    case $stage in
    waiting-for-internet | installing | retrying | checking-boot | host-setup | staging-macos-step) echo "$stage" ;;
    esac
    return 0
  fi
  creating || return 0
  stage=$(progress_value stage)
  echo "${stage:-importing} $(progress_value percent)"
}

# "Importing, 10%" for a notification.
progress_summary() {
  local stage percent
  read -r stage percent <<<"$1"
  printf '%s%s' "$(stage_name "$stage")" "${percent:+, $percent%}"
}

# Run COMMAND..., copying its output to the create log and moving the progress
# on at the lines omvm prints at each step.
tracked() {
  local line
  "$@" 2>&1 | while IFS= read -r line; do
    printf '%s\n' "$line"
    printf '%s\n' "$line" >>"$create_log"
    case $line in
    *"== verifying transfer checksums"*) set_progress importing 5 "Verifying the transfer" ;;
    *"== unpacking bundle"*) set_progress importing 10 "Unpacking the VM (the longest part, 10-15 minutes)" ;;
    *"== checking bundle manifest"*) set_progress importing 28 "Checking the VM" ;;
    *"== re-sparsifying disk image"*) set_progress importing 30 "Compacting the disk image" ;;
    *"== wrote "*) set_progress importing 34 "Imported" ;;
    *"creating guest account"*) set_progress setting-up 45 "Creating the macOS account (about 3 minutes)" ;;
    *"headless settings"*) set_progress setting-up 55 "Installing the Command Line Tools (about 5 minutes)" ;;
    *"installing Xcode"*) set_progress setting-up 70 "Installing Xcode (about 15 minutes)" ;;
    *"building the GPU-path QEMU"*) set_progress setting-up 90 "Building the display backend (once, about 15 minutes)" ;;
    esac
  done
  return "${PIPESTATUS[0]}"
}

# Open the progress view in a floating terminal, unless one is open already.
open_progress() {
  local pid
  pid=$(cat "$progress_pid" 2>/dev/null)
  [[ -n $pid ]] && kill -0 "$pid" 2>/dev/null && return 0
  [[ -n ${WAYLAND_DISPLAY:-} ]] || return 0
  systemd-run --user --unit=omarchy-macos-vm-progress-view --collect --quiet \
    omarchy-launch-floating-terminal-with-presentation "omarchy-macos-vm progress" >/dev/null 2>&1 || true
}

progress_bar() {
  local percent=${1:-0} width=30 filled
  [[ $percent =~ ^[0-9]{1,3}$ ]] && ((percent <= 100)) || percent=0
  filled=$((percent * width / 100))
  printf '[%s%s] %3s%%' "$(printf '%*s' "$filled" '' | tr ' ' '#')" "$(printf '%*s' $((width - filled)) '' | tr ' ' '.')" "$percent"
}

# The view: every stage with where it is, the current step and the last lines of output.
show_progress() {
  local stage percent detail failed_stage tier problems mark name current_index=0 i
  local -a stages=(importing restart-needed setting-up ready)
  echo $$ >"$progress_pid" 2>/dev/null
  trap 'rm -f "$progress_pid"' EXIT
  while true; do
    failed_stage=""
    tier=$(active_tier)
    if [[ ! -e $state_dir/done ]]; then
      stage=$(system_stage)
      failed_stage=$(system_failed_stage)
      percent=0
      case $stage in
      waiting-for-internet) detail="Connect to Wi-Fi: the setup starts as soon as this Mac is online." ;;
      retrying) detail=$(cat "$state_dir/last-error" 2>/dev/null || echo "Retrying stack installation") ;;
      failed) detail=$(cat "$state_dir/last-error" 2>/dev/null || echo "The macOS VM stack setup failed") ;;
      *) stage=installing detail="Installing the macOS VM packages (a few minutes)" ;;
      esac
    else
      stage=$(progress_value stage)
      percent=$(progress_value percent)
      detail=$(progress_value detail)
      failed_stage=$(progress_value failed_stage)
      [[ -n $(progress_value tier) ]] && tier=$(progress_value tier)
      if [[ $stage == failed ]] && ! creating; then
        # Fail-closed: never report ready when a setup stage failed, even if vm_exists is true.
        :
      elif [[ $stage == ready ]]; then
        problems=$(readiness_problems)
        if [[ -n $problems ]]; then
          stage=failed
          detail="VM is not ready: $problems"
        fi
      elif [[ -z $stage ]] && ! creating && vm_ready; then
        stage=ready percent=100 detail="The macOS VM is ready"
      elif [[ -z $stage ]] || { creating && [[ $stage == restart-needed || $stage == failed ]]; }; then
        # A new run has started and not written its first step yet.
        stage=importing percent=0 detail="Starting" failed_stage=""
      fi
    fi
    printf '\033[H\033[2J'
    printf '\n  macOS VM setup\n\n'
    current_index=-1
    for i in "${!stages[@]}"; do [[ ${stages[i]} == "$stage" ]] && current_index=$i; done
    if ((current_index < 0)) && [[ -n $stage ]]; then
      if [[ $stage == failed && -n $failed_stage ]]; then
        printf '  > Failed (%s)\n' "$failed_stage"
      else
        printf '  > %s\n' "$(stage_name "${stage:-waiting}")"
      fi
    fi
    for i in "${!stages[@]}"; do
      name=$(stage_name "${stages[i]}")
      if ((current_index < 0 || i > current_index)); then
        mark=" "
      elif ((i < current_index)) || [[ ${stages[i]} == ready ]]; then
        mark="x"
      else
        mark=">"
      fi
      printf '  [%s] %s\n' "$mark" "$name"
    done
    printf '\n  %s\n  %s\n' "$(progress_bar "${percent:-0}")" "${detail:-}"
    if [[ $stage == importing && -d $omvm_images ]]; then
      printf '  Imported so far: %s\n' "$(du -sh "$omvm_images" 2>/dev/null | cut -f1)"
    fi
    if [[ -s $create_log ]]; then
      printf '\n  Last output:\n'
      tail -n 6 "$create_log" | cut -c1-100 | sed 's/^/    /'
    fi
    case $stage in
    ready)
      printf '\n  macOS VM ready: open it from Super + Space (macOS).\n'
      if [[ $tier == apple-services ]] || apple_services_enabled; then
        printf '  Apple services: enabled\n'
      fi
      if [[ -n $(shown_username) ]]; then
        printf '\n'
        credential_lines | sed 's/^/  /'
        printf '  It logs in by itself; the password unlocks the screen and sudo.\n'
      fi
      return 0
      ;;
    restart-needed)
      printf '\n  Restart needed. %s\n' "$(restart_step)"
      return 0
      ;;
    failed)
      if [[ -e $state_dir/done ]]; then
        if [[ $failed_stage == apple_services || $failed_stage == apple-services ]]; then
          printf '\n  The setup stopped during Apple services enablement. Retry: omarchy-macos-vm create\n'
        else
          printf '\n  The setup stopped. Retry: omarchy-macos-vm create\n'
        fi
      else
        printf '\n  The setup stopped. Details: journalctl -u omarchy-macos-vm-setup\n'
      fi
      return 1
      ;;
    esac
    if [[ -e $state_dir/done ]] && ! creating; then
      printf '\n  Nothing is running right now. %s\n' "$(pending_step | head -1)"
      return 0
    fi
    sleep "${OMARCHY_MACOS_VM_PROGRESS_POLL:-2}"
  done
}

# What to do on the stock kernel once the VM is imported.
restart_step() {
  if side_kernel_default; then
    echo "Restart once: Omarchy starts $side_kernel by default and finishes the VM at the next login."
  else
    echo "Boot $side_kernel from the Limine menu; the VM is finished at the next login."
  fi
}

# The VM exists once omvm virt defined it in libvirt; omvm mode names its display.
vm_exists() { command -v omvm >/dev/null && omvm mode "$vm_name" >/dev/null 2>&1; }
vm_state() { "${VIRSH[@]}" domstate "$vm_name" 2>/dev/null | head -1; }

available_storage_gb() {
  local path=$omvm_data
  while [[ ! -d $path ]]; do path=$(dirname -- "$path"); done
  df -P -- "$path" | awk 'NR==2 {print int($4/1024/1024)}'
}

# The launcher entry, like windows-vm.desktop: "macOS" in Super + Space.
verify_desktop_entry() {
  [[ -f $desktop_file && -s $desktop_file ]] &&
    grep -Fqx '[Desktop Entry]' "$desktop_file" &&
    grep -Eq '^Name=' "$desktop_file" &&
    grep -Eq '^Exec=' "$desktop_file"
}

write_desktop_entry() {
  local tmp
  [[ ! -d $desktop_file ]] || return 1
  mkdir -p "${desktop_file%/*}" || return 1
  tmp=$(mktemp "${desktop_file%/*}/.macos-vm.desktop.XXXXXX") || return 1
  if ! cat >"$tmp" <<'EOF' || ! mv -fT "$tmp" "$desktop_file"; then
[Desktop Entry]
Name=macOS
Comment=Start the macOS VM (omvm) and open its window
Exec=uwsm app -- omarchy-macos-vm launch
Icon=macos
Terminal=false
Type=Application
Categories=System;Virtualization;
Keywords=omvm;macOS;VM;
EOF
    rm -f "$tmp"
    return 1
  fi
  verify_desktop_entry
}

apple_services_selection() {
  local selected
  ((request_apple_services)) && { echo apple-services; return; }
  case ${OMARCHY_MACOS_VM_APPLE_SERVICES:-} in
    1) echo apple-services; return ;;
    0) echo basic; return ;;
  esac
  selected=$(sed -n 's/^APPLE_SERVICES=//p' "$config_file" 2>/dev/null | tail -1)
  case $selected in
    1) echo apple-services; return ;;
    0) echo basic; return ;;
  esac
  [[ -f $marker ]] || return 0
  python3 -I -c 'import json, sys
try:
    d = json.load(open(sys.argv[1]))
    if d.get("tier") in ("basic", "apple-services"):
        print(d["tier"])
    elif isinstance(d.get("apple_services"), bool):
        print("apple-services" if d["apple_services"] else "basic")
except Exception:
    pass' "$marker" 2>/dev/null
}

apple_services_requested() {
  case $(apple_services_selection) in
    apple-services) return 0 ;;
    basic) return 1 ;;
  esac
  # Imported identity or VM enrollment is a partial legacy Apple-services setup.
  # An installed helper executable or template alone does not request that tier.
  [[ -e $apple_sep_conf || -e $apple_provider || -e $omvm_images/vms/$vm_name/apple_services ]]
}

active_tier() {
  if apple_services_requested; then
    echo "apple-services"
  else
    echo "basic"
  fi
}

apple_services_missing_prereqs() {
  local -a missing=()
  [[ -e $apple_sep_conf ]] || missing+=("$apple_sep_conf")
  [[ -s $apple_template ]] || missing+=("$apple_template")
  [[ -s $apple_provider ]] || missing+=("$apple_provider")
  [[ -x $apple_qemu ]] || missing+=("$apple_qemu")
  [[ -x $apple_helper ]] || missing+=("$apple_helper")
  if ((${#missing[@]})); then
    local IFS=", "
    printf '%s\n' "${missing[*]}"
  fi
}

apple_services_imported() {
  [[ -z $(apple_services_missing_prereqs) ]]
}

apple_services_enabled() {
  [[ -e $omvm_images/vms/$vm_name/apple_services ]] &&
    "${VIRSH[@]}" dumpxml --inactive "$vm_name" 2>/dev/null |
    grep -q "relay-socket=/run/omvm-fairplay-managed-$vm_name/"
}

# Report every unsatisfied readiness requirement (empty output means fully ready).
readiness_problems() {
  local -a problems=()
  local pstage fstage detail missing bad_stages stage
  if [[ ! -e $state_dir/done ]]; then
    problems+=("macOS VM stack is not installed ($state_dir/done missing)")
  elif [[ $(system_stage) == failed ]]; then
    problems+=("macOS VM stack setup failed ($(cat "$state_dir/last-error" 2>/dev/null || echo 'see journalctl -u omarchy-macos-vm-setup'))")
  fi
  pstage=$(progress_value stage)
  if [[ $pstage == failed ]]; then
    fstage=$(progress_value failed_stage)
    detail=$(progress_value detail)
    problems+=("setup failed${fstage:+ at $fstage}${detail:+: $detail}")
  fi
  [[ $pstage == ready ]] || problems+=("setup has no verified ready result")
  for stage in stack credentials ingest kernel setup virt launcher; do
    [[ $(stage_outcome "$stage") == ok ]] || problems+=("stage '$stage' is not verified")
  done
  if [[ -f $stages_file ]]; then
    bad_stages=$(grep -E '=(failed|skipped|pending)$' "$stages_file" | tr '\n' ',' | sed 's/,$//')
    [[ -n $bad_stages ]] && problems+=("incomplete stages ($bad_stages)")
  fi
  vm_exists || problems+=("VM $vm_name is not defined in libvirt")
  [[ -s $user_state/vm-created ]] || problems+=("completion marker missing ($user_state/vm-created)")
  verify_desktop_entry || problems+=("macOS launcher missing or invalid ($desktop_file)")
  if apple_services_requested; then
    missing=$(apple_services_missing_prereqs)
    if [[ -n $missing ]]; then
      problems+=("Apple services requested/triggered but prerequisites are missing: $missing")
    elif ! apple_services_enabled; then
      problems+=("Apple services requested/triggered but not enabled on $vm_name")
    fi
  fi
  if ((${#problems[@]})); then
    local IFS="; "
    printf '%s\n' "${problems[*]}"
  fi
}

vm_ready() {
  [[ -z $(readiness_problems) ]]
}

setup_failed() {
  [[ ! -e $state_dir/done && $(system_stage) == failed ]] && return 0
  [[ $(progress_value stage) == failed ]] && return 0
  [[ -f $stages_file ]] && grep -Eq '=(failed|skipped)$' "$stages_file" && return 0
  return 1
}

# The window omvm show brings up: reims-vgpu's own window in local mode, a VNC
# viewer in remote mode.
vm_window() {
  local class=vncviewer
  [[ $(omvm mode "$vm_name" 2>/dev/null) == local ]] && class='^reims-vgpu$'
  hyprctl clients -j 2>/dev/null | jq -r --arg re "$class" 'first(.[] | select(.class | test($re; "i")) | .address) // empty'
}
window_open() { hyprctl clients -j 2>/dev/null | jq -e --arg a "$1" 'any(.[]; .address == $a)' >/dev/null; }

fullscreen_focused() {
  hyprctl dispatch 'hl.dsp.window.fullscreen_state({ internal = 2, client = 2 })' >/dev/null 2>&1 ||
    hyprctl dispatch fullscreenstate 2 2 >/dev/null 2>&1 || true
}

# The guest is up once omvm can log in over SSH (the account omvm setup made).
wait_until_up() {
  local i timeout=${OMARCHY_MACOS_VM_BOOT_TIMEOUT:-180}
  for ((i = 0; i < timeout; i += 3)); do
    timeout 8 omvm ssh "$vm_name" true </dev/null >/dev/null 2>&1 && return 0
    [[ $(vm_state) == running ]] || return 1
    sleep 3
  done
  return 1
}

# What is left before the VM exists, as one line for a notification.
pending_step() {
  local detail
  if [[ ! -e $state_dir/done ]]; then
    case $(system_stage) in
    waiting-for-internet) echo "Waiting for internet to set up the macOS VM: connect to Wi-Fi." ;;
    installing | retrying | checking-boot | host-setup | staging-macos-step) echo "Installing the macOS VM stack; the VM is created next." ;;
    failed)
      detail=$(cat "$state_dir/last-error" 2>/dev/null)
      echo "Stack setup failed${detail:+: $detail}. See journalctl -u omarchy-macos-vm-setup."
      ;;
    *) echo "Set up the stack first: Install > macOS in the Omarchy menu." ;;
    esac
  elif [[ $(progress_value stage) == failed ]]; then
    detail=$(progress_value detail)
    echo "Setup failed${detail:+: $detail}. Retry: omarchy-macos-vm create"
  elif bundle_ingested || vmxfer_ready; then
    if bundle_ingested && ! on_side_kernel; then
      restart_step
    else
      echo "Finish it: omarchy-macos-vm create (ingest, setup, virt)."
    fi
  elif [[ -s $state_dir/next-steps.txt ]]; then
    grep -E '^[0-9]+\.' "$state_dir/next-steps.txt" | tr -s ' '
  else
    echo "Do the one-time macOS step: omvm macos-step prints it."
  fi
}

print_pending() {
  if [[ -e $state_dir/done ]] && ! bundle_ingested && ! vmxfer_ready && [[ -s $state_dir/next-steps.txt ]]; then
    cat "$state_dir/next-steps.txt"
    echo
    echo "After the macOS step, the rest (omvm ingest, setup, virt) runs at the next Omarchy login."
  else
    pending_step
  fi
}

# --- commands ----------------------------------------------------------------

install_stack() {
  if [[ ! -e $marker ]]; then
    sudo install -d -m 0755 "${marker%/*}" &&
      printf '{"version":1,"requested_by":"menu"}\n' | sudo tee "$marker" >/dev/null || return 1
  fi
  if omarchy-pkg-missing omarchy-macos-vm; then
    omarchy-pkg-add omarchy-macos-vm || {
      echo "❌ omarchy-macos-vm is in no repository this Mac uses (see omarchy-mac-pkgs macos-vm BUILD.md)." >&2
      return 1
    }
  fi
  [[ -e $state_dir/done ]] && return 0
  sudo systemctl enable omarchy-macos-vm-setup.service >/dev/null 2>&1 || true
  echo "Installing the macOS VM stack (the log follows; this can take a few minutes)..."
  sudo systemctl start omarchy-macos-vm-setup.service &
  local starter=$!
  journalctl -f -n 0 -o cat -u omarchy-macos-vm-setup.service &
  local follower=$!
  wait "$starter"
  local status=$?
  kill "$follower" 2>/dev/null
  if ((status != 0)) || [[ ! -e $state_dir/done ]]; then
    echo "❌ The setup did not finish: $(sudo cat "$state_dir/last-error" 2>/dev/null || echo 'see journalctl -u omarchy-macos-vm-setup')" >&2
    return 1
  fi
  systemctl --user start omarchy-macos-vm-user.service 2>/dev/null || omvm prepare || {
    echo "❌ Failed to prepare omvm for this user." >&2
    return 1
  }
}

install_macos() {
  local arg
  for arg in "$@"; do
    case $arg in
    --apple-services) request_apple_services=1 ;;
    "") ;;
    *)
      echo "Unknown install option: $arg" >&2
      return 1
      ;;
    esac
  done
  trap "echo ''; echo 'Installation cancelled by user'; exit 1" INT

  supported_mac || {
    echo "macOS VMs need an M1 or M2 Mac running Omarchy." >&2
    exit 1
  }
  omarchy-pkg-add gum >/dev/null 2>&1 || command -v gum >/dev/null || exit 1

  local total_ram total_ram_gb total_cores ram_options="" size selected_ram selected_cores
  local default_ram default_cores account password password_display available
  total_ram=$(free -h | awk 'NR==2 {print $2}')
  total_ram_gb=$(awk 'NR==1 {printf "%d", $2/1024/1024}' /proc/meminfo)
  total_cores=$(nproc)

  echo ""
  echo "System Resources Detected:"
  echo "  Total RAM: $total_ram"
  echo "  Total CPU Cores: $total_cores"
  echo ""

  for size in 4 8 16 32 64; do
    ((size < total_ram_gb)) && ram_options="$ram_options ${size}G"
  done
  [[ -n $ram_options ]] || {
    echo "❌ Not enough memory for a macOS VM (it needs 4G and some left for Omarchy)." >&2
    exit 1
  }
  default_ram="$(setting RAM_GIB 16)G"
  grep -qw -- "$default_ram" <<<"$ram_options" || default_ram=$(tr ' ' '\n' <<<"$ram_options" | tail -1)
  selected_ram=$(tr ' ' '\n' <<<"${ram_options# }" | gum choose --selected="$default_ram" --header="How much RAM would you like to allocate to macOS VM?")
  if [[ -z $selected_ram ]]; then
    echo "Installation cancelled by user"
    exit 1
  fi

  default_cores=$(setting CPUS 8)
  ((default_cores > total_cores)) && default_cores=$total_cores
  selected_cores=$(gum input --placeholder="Number of CPU cores (1-$total_cores)" --value="$default_cores" --header="How many CPU cores would you like to allocate to macOS VM?" --char-limit=2)
  if [[ -z $selected_cores ]]; then
    echo "Installation cancelled by user"
    exit 1
  fi
  if ! valid_cores "$selected_cores" || ((selected_cores > total_cores)); then
    echo "Invalid input. Using default: $default_cores cores"
    selected_cores=$default_cores
  fi

  # The guest disk is the 160 GB (sparse) disk of the macOS restore; there is no
  # size to choose, but the images need room on this disk.
  if ! vm_exists; then
    available=$(available_storage_gb) || available=0
    if ((available < REQUIRED_SPACE_GB)); then
      echo "❌ Insufficient disk space!"
      echo "   Available: ${available}GB"
      echo "   Required: ${REQUIRED_SPACE_GB}GB (the restored VM, Xcode and the setup layers)"
      exit 1
    fi
  fi

  if account_created; then
    account=$(shown_username)
    password_display="(set when the account was created)"
  else
    local default_account
    default_account=$(read_credential USERNAME || guest_user)
    [[ -n $default_account ]] || default_account=$(id -un)
    valid_account "$default_account" || default_account=$(id -un)
    account=$(gum input --placeholder="macOS username (Press enter to use default: $default_account)" --header="Enter the macOS username:")
    [[ -n $account ]] || account=$default_account
    if ! valid_account "$account"; then
      echo "Invalid username (lowercase letters, digits, - or _, up to 31 chars). Using default: $default_account"
      account=$default_account
    fi
    password=$(gum input --placeholder="Password (Press enter to use default: $DEFAULT_PASSWORD)" --password --header="Enter the macOS password:")
    if [[ -z $password ]]; then
      password=$DEFAULT_PASSWORD
      password_display="(default: $DEFAULT_PASSWORD)"
    elif valid_password "$password"; then
      password_display="(user-defined)"
    else
      echo "Invalid password (printable characters except ', up to 64). Using default: $DEFAULT_PASSWORD"
      password=$DEFAULT_PASSWORD
      password_display="(default: $DEFAULT_PASSWORD)"
    fi
  fi

  gum style \
    --border normal \
    --padding "1 2" \
    --margin "1" \
    --align left \
    --bold \
    "macOS VM Configuration" \
    "" \
    "RAM:       $selected_ram" \
    "CPU:       $selected_cores cores" \
    "Disk:      160G (sparse, from the macOS restore)" \
    "Username:  ${account:-(existing)}" \
    "Password:  $password_display" \
    "Login:     automatic (the password unlocks the screen and sudo)"

  echo ""
  if ! gum confirm "Proceed with this configuration?"; then
    echo "Installation cancelled by user"
    exit 1
  fi

  save_settings "${selected_ram%G}" "$selected_cores" "$request_apple_services" || {
    echo "❌ Failed to write $config_file." >&2
    exit 1
  }
  if ! account_created; then
    write_credentials "$account" "$password" && apply_credentials || {
      echo "❌ Failed to store the macOS username and password ($credentials_file)." >&2
      exit 1
    }
  fi

  install_stack || exit 1
  write_desktop_entry || {
    echo "❌ Failed to create or verify the macOS launcher entry ($desktop_file)." >&2
    exit 1
  }

  if vm_ready; then
    echo ""
    echo "Applying the new settings to the existing macOS VM..."
    CPUS=$selected_cores RAM_GIB=${selected_ram%G} omvm virt "$vm_name" || exit 1
    echo ""
    echo "The new RAM and CPU settings apply from the VM's next start."
    echo "Launch 'macOS' via Super + Space"
    return 0
  fi

  # Look on VMXFER for the macOS step's output now rather than at the next boot.
  if ! sudo systemctl start omarchy-macos-vm-vmxfer.service 2>/dev/null; then
    echo "⚠️  Could not probe VMXFER via omarchy-macos-vm-vmxfer.service." >&2
  fi
  if bundle_ingested || vmxfer_ready || vm_exists; then
    echo ""
    echo "The restored macOS VM is on VMXFER: creating it now."
    local -a create_args=()
    ((request_apple_services)) && create_args+=(--apple-services)
    create_macos "${create_args[@]}"
    return
  fi

  echo ""
  print_pending
  notify -u critical -t 0 "macOS VM: one step in macOS" "$(pending_step)" \
    --exec "omarchy-launch-floating-terminal-with-presentation 'cat $state_dir/next-steps.txt'"
  echo ""
  echo "Once finished, launch 'macOS' via Super + Space"
}

# --auto, at login with nobody at a terminal: the guest account is the one the
# installer or the wizard stored, else this user's name with the password
# "macos"; the VM gets half the RAM (4-16G) and all but two cores (2-8), unless
# omarchy-macos-vm install already chose them.
auto_defaults() {
  local user
  # The account: the stored one (the installer's or the wizard's), else this
  # user's name and the default password, as the Windows VM does.
  if ! account_created; then
    if [[ ! -s $credentials_file ]]; then
      user=$(guest_user)
      valid_account "${user:-}" || user=$(id -un)
      valid_account "$user" || user=macos
      write_credentials "$user" "$DEFAULT_PASSWORD" || return 1
    fi
    apply_credentials || return 1
  elif [[ -z $(guest_user) ]] && valid_account "$(id -un)"; then
    save_guest_user "$(id -un)" || return 1
  fi
  [[ -s $config_file ]] && return 0
  local ram cpus
  ram=$(awk 'NR==1 {printf "%d", $2/1024/1024/2}' "${OMARCHY_MACOS_VM_MEMINFO:-/proc/meminfo}")
  ((ram > 16)) && ram=16
  ((ram < 4)) && ram=4
  cpus=$(($(nproc) - 2))
  ((cpus > 8)) && cpus=8
  ((cpus < 2)) && cpus=2
  save_settings "$ram" "$cpus"
}

# STAGE PERCENT MESSAGE [NOTIFY_BODY] [STAGE_OUTCOME]: fail closed and record diagnostics.
fail_create() {
  local failed_stage=$1 percent=$2 message=$3 notify_body=${4:-$3} outcome=${5:-failed}
  rm -f "$user_state/vm-created"
  set_stage_outcome "$failed_stage" "$outcome" || true
  set_progress failed "${percent:-0}" "$message" "$failed_stage" || true
  echo "❌ $message" >&2
  notify -u critical "macOS VM setup failed ($failed_stage)" "$notify_body"
  return 1
}

# Verify every required stage for TIER succeeded before marking the VM ready.
verify_create_readiness() {
  local tier=$1 stage
  local -a required=(stack credentials ingest kernel setup virt launcher)
  [[ $tier == apple-services ]] && required+=(apple_services)
  for stage in "${required[@]}"; do
    [[ $(stage_outcome "$stage") == ok ]] || {
      echo "stage '$stage' did not succeed (recorded: $(stage_outcome "$stage"))"
      return 1
    }
  done
  [[ -e $state_dir/done && $(system_stage) != failed ]] || {
    echo "macOS VM stack setup is not complete ($state_dir/done)"
    return 1
  }
  bundle_ingested || { echo "VMXFER bundle is not ingested"; return 1; }
  on_side_kernel || { echo "side kernel $side_kernel is not active"; return 1; }
  account_created || { echo "guest image (*-v0) was not created by omvm setup"; return 1; }
  vm_exists || { echo "VM $vm_name is not defined in libvirt"; return 1; }
  if [[ $tier == apple-services ]]; then
    apple_services_enabled || { echo "Apple services are not enabled on $vm_name"; return 1; }
  fi
  verify_desktop_entry || { echo "macOS launcher ($desktop_file) is missing or invalid"; return 1; }
  return 0
}

# ingest -> setup [--xcode] -> virt [-> apple-services] -> launcher, each step
# skipped only when already verified. Runs from install, from each login until
# the VM is ready (--auto), or by hand.
create_macos() {
  local auto=0 arg tier missing reason ready_detail tmp_created
  for arg in "$@"; do
    case $arg in
    --auto) auto=1 ;;
    --apple-services) request_apple_services=1 ;;
    "") ;;
    *)
      echo "Unknown create option: $arg" >&2
      return 1
      ;;
    esac
  done
  if vm_ready; then
    echo "The macOS VM $vm_name already exists. Launch 'macOS' via Super + Space"
    return 0
  fi
  mkdir -p "$user_state" || {
    echo "❌ Cannot create user state directory $user_state." >&2
    return 1
  }
  # Fail-closed: never retain a stale completion marker across an incomplete run.
  rm -f "$user_state/vm-created"
  reset_stages || {
    echo "❌ Cannot initialize stage tracking in $stages_file." >&2
    return 1
  }

  if [[ ! -e $state_dir/done || $(system_stage) == failed ]]; then
    local stack_err
    stack_err=$(cat "$state_dir/last-error" 2>/dev/null || true)
    fail_create stack 0 \
      "The macOS VM stack is not installed${stack_err:+ ($stack_err)}. To set up: omarchy-macos-vm install"
    return 1
  fi
  set_stage_outcome stack ok

  if ! bundle_ingested && ! vmxfer_ready; then
    print_pending >&2
    fail_create ingest 0 \
      "No restored macOS VM found on VMXFER; complete the one-time macOS step before running omarchy-macos-vm create"
    return 1
  fi

  if credentials_pending && ! account_created; then
    set_stage_outcome credentials waiting
    set_progress restart-needed 0 "The account from the installer is handed over at the next boot."
    echo "The macOS username and password from the installer are handed over at the next boot; restart, then the VM is finished at the next login." >&2
    notify -u critical "macOS VM: restart to finish" "The account from the installer is handed over at the next boot."
    return 2
  fi
  if ((auto)); then
    auto_defaults || {
      fail_create credentials 0 "Failed to save the macOS VM settings."
      return 1
    }
  fi
  # omvm setup would ask for the account on a terminal its output no longer reaches.
  if ! account_created && [[ ! -s $credentials_file ]]; then
    local account="" password=""
    if [[ -t 0 ]]; then
      account=$(gum input --header="Enter the macOS username:" --value="$(guest_user || id -un)" 2>/dev/null)
      password=$(gum input --password --placeholder="Press enter to use default: $DEFAULT_PASSWORD" --header="Enter the macOS password:" 2>/dev/null)
    fi
    valid_account "${account:-}" || account=$(guest_user)
    valid_account "${account:-}" || account=$(id -un)
    valid_password "${password:-}" || password=$DEFAULT_PASSWORD
    write_credentials "$account" "$password" || {
      fail_create credentials 0 "Failed to store the macOS account credentials ($credentials_file)."
      return 1
    }
  fi
  if ! account_created; then
    apply_credentials || {
      fail_create credentials 0 "Failed to hand the macOS account to omvm."
      return 1
    }
  fi
  set_stage_outcome credentials ok

  : >"$create_log"
  if bundle_ingested; then
    set_progress setting-up 36 "Starting the setup"
  else
    set_progress importing 1 "Starting the import"
  fi

  if ! bundle_ingested; then
    local available mnt
    available=$(available_storage_gb) || available=0
    if ((available < REQUIRED_SPACE_GB)); then
      fail_create ingest 1 \
        "${available}GB free; the macOS VM needs ${REQUIRED_SPACE_GB}GB in Omarchy." \
        "It needs ${REQUIRED_SPACE_GB} GB free in Omarchy; ${available} GB is free."
      return 1
    fi
    mnt=$(vmxfer_mount)
    [[ -n $mnt && -d $mnt ]] && export MNT=$mnt
    set_progress importing 2 "Importing the VM restored in macOS (10-20 minutes)"
    notify "Creating the macOS VM" "Importing the VM restored in macOS (omvm ingest)"
    echo "Importing the VM restored in macOS (omvm ingest; this can take 10-20 minutes)..."
    tracked omvm ingest || {
      fail_create ingest "$(progress_value percent)" \
        "omvm ingest failed; run omarchy-macos-vm create to retry"
      return 1
    }
    if ! bundle_ingested; then
      fail_create ingest "$(progress_value percent)" \
        "omvm ingest exited without producing an ingested bundle (*-restore/.ingested); run omarchy-macos-vm create to retry" \
        "omvm ingest did not produce an ingested bundle; run omarchy-macos-vm create to retry" \
        skipped
      return 1
    fi
  fi
  set_stage_outcome ingest ok

  if ! on_side_kernel; then
    echo ""
    echo "The rest needs the macOS VM kernel ($side_kernel)."
    restart_step
    set_stage_outcome kernel restart-needed
    set_progress restart-needed 35 "$(restart_step)"
    notify -u critical -t 0 "macOS VM: restart to finish" "$(restart_step)"
    return 2
  fi
  set_stage_outcome kernel ok

  local xcode=()
  [[ -f $omvm_images/Xcode.dmg ]] && xcode=(--xcode)
  if ! (account_created && vm_exists); then
    set_progress setting-up 40 "Setting up the guest (10-30 minutes)"
    notify "Creating the macOS VM" "Setting up the guest (omvm setup${xcode:+ --xcode}); this takes 10-30 minutes"
    echo "Setting up the guest (omvm setup ${xcode[*]:-})..."
    if ! tracked omvm setup ${xcode[@]+"${xcode[@]}"}; then
      fail_create setup "$(progress_value percent)" \
        "omvm setup failed; run omarchy-macos-vm create to retry"
      return 1
    fi
    if ! account_created; then
      fail_create setup "$(progress_value percent)" \
        "omvm setup exited without creating the guest image (*-v0); run omarchy-macos-vm create to retry" \
        "omvm setup did not create the guest image; run omarchy-macos-vm create to retry" \
        skipped
      return 1
    fi
  fi
  set_stage_outcome setup ok

  if ! vm_exists; then
    set_progress setting-up 85 "Defining the VM"
    CPUS=$(setting CPUS 8) RAM_GIB=$(setting RAM_GIB 16) tracked omvm virt "$vm_name" || {
      fail_create virt "$(progress_value percent)" \
        "omvm virt failed; run omarchy-macos-vm create to retry"
      return 1
    }
    if ! vm_exists; then
      fail_create virt "$(progress_value percent)" \
        "omvm virt exited without defining VM $vm_name; run omarchy-macos-vm create to retry" \
        "omvm virt did not define VM $vm_name; run omarchy-macos-vm create to retry" \
        skipped
      return 1
    fi
  fi
  set_stage_outcome virt ok

  tier=$(active_tier)
  if [[ $tier == apple-services ]]; then
    missing=$(apple_services_missing_prereqs)
    if [[ -n $missing ]]; then
      fail_create apple_services 90 \
        "Apple services requested/triggered but prerequisites are missing ($missing); run: omarchy-macos-vm apple-services import old-root" \
        "Apple services prerequisites missing ($missing). Run: omarchy-macos-vm apple-services import old-root, then omarchy-macos-vm create." \
        skipped
      return 1
    fi
    set_progress setting-up 90 "Enrolling the VM for Apple Account sign-in"
    if ! tracked apple_services_enable; then
      fail_create apple_services 90 \
        "Apple services enablement failed for $vm_name; fix prerequisites/enrollment and retry: omarchy-macos-vm create"
      return 1
    fi
    if ! apple_services_enabled; then
      fail_create apple_services 90 \
        "Apple services enablement exited without configuring $vm_name; retry: omarchy-macos-vm apple-services enable" \
        "Apple services were not configured on $vm_name; retry: omarchy-macos-vm apple-services enable" \
        skipped
      return 1
    fi
    set_stage_outcome apple_services ok
  else
    set_stage_outcome apple_services not-requested
  fi

  set_progress setting-up 95 "Creating the macOS launcher"
  if ! write_desktop_entry || ! verify_desktop_entry; then
    fail_create launcher 95 \
      "Failed to create or verify the macOS launcher ($desktop_file); check permissions and retry: omarchy-macos-vm create"
    return 1
  fi
  set_stage_outcome launcher ok

  if ! reason=$(verify_create_readiness "$tier"); then
    fail_create readiness 99 "Setup readiness verification failed: $reason"
    return 1
  fi

  tmp_created=$(mktemp "$user_state/.vm-created.XXXXXX") || {
    fail_create readiness 99 "Failed to create temporary readiness marker in $user_state"
    return 1
  }
  if ! date -u +%FT%TZ >"$tmp_created" || ! mv -f "$tmp_created" "$user_state/vm-created"; then
    rm -f "$tmp_created"
    fail_create readiness 99 "Failed to write readiness marker ($user_state/vm-created)"
    return 1
  fi

  ready_detail="The macOS VM is ready"
  [[ $tier == apple-services ]] && ready_detail="The macOS VM is ready (with Apple services)"
  if ! set_progress ready 100 "$ready_detail"; then
    fail_create readiness 99 "Failed to record completed setup progress"
    return 1
  fi
  echo ""
  echo "macOS VM is ready! Launch 'macOS' via Super + Space"
  [[ $tier == apple-services ]] && echo "Apple services: enabled"
  credential_lines
  notify "macOS VM ready — open it from Super+Space" "Opening it now; later, choose macOS in Super + Space"
  # Unattended: open it the way the "macOS" launcher entry does, once.
  if ((auto)) && [[ -z ${OMARCHY_MACOS_VM_NO_LAUNCH:-} ]]; then
    systemd-run --user --unit=omarchy-macos-vm-launch --collect --quiet \
      --description="Omarchy: open the macOS VM" omarchy-macos-vm launch ||
      echo "Could not open the macOS VM; launch 'macOS' via Super + Space" >&2
  fi
}

# The VM's FairPlay identifier is its IOPlatformUUID, read from the running
# guest; enrollment needs every guest stopped, then the VM is redefined with
# the identity device, the SEP socket and its FairPlay helper.
apple_services_enable() {
  local missing
  missing=$(apple_services_missing_prereqs)
  if [[ -n $missing ]]; then
    echo "Apple services prerequisites are missing ($missing): run omarchy-macos-vm apple-services import old-root" >&2
    return 1
  fi
  vm_exists || {
    echo "The macOS VM $vm_name does not exist yet." >&2
    return 1
  }
  if apple_services_enabled; then
    echo "$vm_name already has the Apple services."
    return 0
  fi
  local uuid
  if [[ $(vm_state) != running ]]; then
    "${VIRSH[@]}" start "$vm_name" >/dev/null || return 1
  fi
  wait_until_up || {
    echo "❌ $vm_name did not come up over SSH." >&2
    return 1
  }
  uuid=$(omvm ssh "$vm_name" "ioreg -rd1 -c IOPlatformExpertDevice" </dev/null |
    sed -nE 's/.*"IOPlatformUUID" = "([0-9A-Fa-f-]{36})".*/\1/p' | head -1)
  [[ ${#uuid} == 36 ]] || {
    echo "❌ Could not read the guest's IOPlatformUUID." >&2
    return 1
  }
  omvm stop "$vm_name" >/dev/null || return 1
  sudo "$apple_helper" enable "$vm_name" --uuid "$uuid" || return 1
  omvm virt "$vm_name" --experimental-apple-services || return 1
  if ! apple_services_enabled; then
    echo "❌ $vm_name was redefined, but Apple services verification failed (missing $omvm_images/vms/$vm_name/apple_services or FairPlay relay socket in libvirt XML)." >&2
    return 1
  fi
  echo "$vm_name: Apple services on (Apple Account sign-in in System Settings)."
}

apple_services() {
  local cmd=${1:-status}
  shift || true
  case $cmd in
  import)
    [[ -n ${1:-} ]] || {
      echo "Usage: omarchy-macos-vm apple-services import SRC|old-root [--os-uuid UUID] [--qemu PATH]" >&2
      return 1
    }
    sudo "$apple_helper" import "$@" --user "$(id -un)"
    ;;
  enable) apple_services_enable ;;
  status) sudo "$apple_helper" status ;;
  *)
    echo "Usage: omarchy-macos-vm apple-services import|enable|status" >&2
    return 1
    ;;
  esac
}

remove_macos() {
  local purge=0
  [[ ${1:-} == --purge ]] && purge=1
  if ! gum confirm --default=false "Remove macOS VM and the macOS VM stack?"; then
    echo "Removal cancelled by user"
    exit 1
  fi

  echo "Removing macOS VM..."
  if vm_exists; then
    omvm virt rm --yes "$vm_name" || {
      echo "❌ Could not remove the macOS VM from libvirt; nothing else was removed." >&2
      exit 1
    }
  fi
  if ((!purge)) && [[ -d $omvm_images ]] && compgen -G "$omvm_images/*" >/dev/null; then
    gum confirm --default=false "Also delete the guest images in $omvm_images ($(du -sh "$omvm_images" 2>/dev/null | cut -f1))?" && purge=1
  fi
  if ((purge)); then
    rm -rf "$omvm_images" "$omvm_password_file" "$credentials_file"
    echo "Guest images deleted."
  elif [[ -d $omvm_images ]]; then
    echo "Guest images kept in $omvm_images."
  fi

  local installed=() package
  for package in "${stack[@]}"; do
    omarchy-pkg-present "$package" && installed+=("$package")
  done
  if ((${#installed[@]})); then
    omarchy-pkg-remove "${installed[@]}" || exit 1
  fi
  if [[ -x $boot_default_helper ]]; then
    sudo "$boot_default_helper" disable || exit 1
  fi
  sudo rm -f "$marker" "$state_dir/done" "$state_dir/vmxfer-ready" "$state_dir/oneshot-armed" "$state_dir/oneshot-tries"
  rm -f "$desktop_file" "$config_file"
  rm -rf "$user_state"

  echo ""
  echo "macOS VM removal completed! linux-aurora boots as before."
}

launch_macos() {
  local keep_alive=false window
  if [[ ${1:-} == --keep-alive || ${1:-} == -k ]]; then
    keep_alive=true
  fi

  if ! vm_exists; then
    local steps open=() running
    running=$(in_progress)
    if [[ -n $running ]]; then
      # Clicked while the VM is being made: say where it is and show the progress.
      echo "The macOS VM is still being set up ($(progress_summary "$running"))." >&2
      notify "macOS VM" "Still setting up ($(progress_summary "$running"))…" \
        --exec "omarchy-launch-floating-terminal-with-presentation 'omarchy-macos-vm progress'"
      open_progress
      exit 0
    fi
    steps=$(pending_step)
    if [[ -e $state_dir/done ]] && { bundle_ingested || vmxfer_ready; } && on_side_kernel; then
      open=(--exec "omarchy-launch-floating-terminal-with-presentation 'omarchy-macos-vm create'")
    elif [[ -s $state_dir/next-steps.txt ]]; then
      # The numbered steps fit a notification; a click shows the whole file.
      open=(--exec "omarchy-launch-floating-terminal-with-presentation 'cat $state_dir/next-steps.txt'")
    fi
    printf 'The macOS VM %s does not exist yet.\n' "$vm_name" >&2
    print_pending >&2
    notify -u critical -t 0 "macOS VM not set up yet" "$steps" "${open[@]}"
    exit 1
  fi

  if setup_failed && ! creating; then
    local fstage detail
    fstage=$(progress_value failed_stage)
    detail=$(progress_value detail)
    echo "❌ macOS VM setup did not finish${fstage:+ (failed at $fstage)}: ${detail:-see omarchy-macos-vm status}." >&2
    echo "   Retry: omarchy-macos-vm create" >&2
    notify -u critical "macOS VM setup incomplete" "${detail:-Run omarchy-macos-vm create to finish setup.}"
    exit 1
  fi
  if apple_services_requested && ! apple_services_enabled; then
    echo "❌ Apple services were requested/triggered for $vm_name but are not enabled." >&2
    echo "   Finish setup: omarchy-macos-vm create" >&2
    notify -u critical "macOS VM: Apple services not enabled" "Run omarchy-macos-vm create to finish Apple services setup."
    exit 1
  fi

  if ! vm_ready; then
    echo "macOS VM setup is incomplete: $(readiness_problems)" >&2
    notify -u critical "macOS VM setup incomplete" "Run omarchy-macos-vm create to verify and finish setup."
    exit 1
  fi

  echo "Starting macOS VM..."
  if [[ $(vm_state) != running ]]; then
    notify "macOS VM" "Starting macOS VM…"
    if ! omvm start "$vm_name"; then
      echo "❌ Failed to start macOS VM!"
      echo "   Try checking: omarchy-macos-vm status"
      notify -u critical "macOS VM" "Failed to start macOS VM"
      exit 1
    fi
  fi
  if ! wait_until_up; then
    if [[ $(vm_state) != running ]]; then
      echo "❌ The macOS VM stopped while booting."
      notify -u critical "macOS VM" "The macOS VM stopped while booting; see omarchy-macos-vm status"
      exit 1
    fi
    echo "macOS has not answered over SSH yet; opening its window anyway."
  fi

  if [[ $keep_alive == true ]]; then
    lifecycle="VM will keep running after its window closes
To stop: omarchy-macos-vm stop"
  else
    lifecycle="VM will auto-stop when its window closes"
  fi
  gum style \
    --border normal \
    --padding "1 2" \
    --margin "1" \
    --align center \
    "Connecting to macOS VM" \
    "" \
    "$lifecycle" 2>/dev/null || printf 'Connecting to macOS VM\n%s\n' "$lifecycle"

  if ! omvm show "$vm_name"; then
    echo "❌ Could not open the macOS VM's window."
    notify -u critical "macOS VM" "Could not open the macOS VM's window; see omarchy-macos-vm status"
    exit 1
  fi
  fullscreen_focused

  window=$(vm_window)
  if [[ -z $window ]]; then
    echo ""
    echo "Could not find the macOS VM's window; it keeps running."
    echo "To stop it: omarchy-macos-vm stop"
    return 0
  fi
  while window_open "$window" && [[ $(vm_state) == running ]]; do
    sleep "${OMARCHY_MACOS_VM_POLL:-2}"
  done

  if [[ $keep_alive == false ]]; then
    echo ""
    echo "Window closed. Stopping macOS VM..."
    if omvm stop "$vm_name"; then
      echo "macOS VM stopped."
    else
      echo "⚠️  Could not stop the macOS VM."
      echo "   It may still be running. Stop it with: omarchy-macos-vm stop"
    fi
  else
    echo ""
    echo "Window closed. macOS VM is still running."
    echo "To stop it: omarchy-macos-vm stop"
  fi
}

stop_macos() {
  if ! vm_exists; then
    echo "macOS VM not configured."
    exit 1
  fi
  echo "Stopping macOS VM..."
  if omvm stop "$vm_name"; then
    echo "macOS VM stopped."
  else
    echo "⚠️  Could not stop the macOS VM. It may still be running."
    exit 1
  fi
}

status_macos() {
  if setup_failed; then
    local fstage detail
    if [[ ! -e $state_dir/done ]]; then
      fstage=$(system_failed_stage)
      detail=$(cat "$state_dir/last-error" 2>/dev/null || echo "see journalctl -u omarchy-macos-vm-setup")
      echo "macOS VM setup failed${fstage:+ (stage: $fstage)}."
      echo "Reason: $detail"
      echo "Details: journalctl -u omarchy-macos-vm-setup"
    else
      fstage=$(progress_value failed_stage)
      detail=$(progress_value detail)
      echo "macOS VM setup failed${fstage:+ (stage: $fstage)}."
      echo "Reason: ${detail:-$(readiness_problems)}"
      echo "Retry: omarchy-macos-vm create"
    fi
    exit 1
  fi
  if ! vm_exists; then
    echo "macOS VM not configured."
    if [[ -e $state_dir/done ]]; then
      echo "Next: $(pending_step | head -1)"
    else
      echo "To set up: omarchy-macos-vm install"
    fi
    exit 1
  fi
  local problems
  problems=$(readiness_problems)
  if [[ -n $problems ]]; then
    echo "macOS VM setup is incomplete (not ready)."
    echo "Issues: $problems"
    echo "Finish setup: omarchy-macos-vm create"
    exit 1
  fi

  local state mode display
  state=$(vm_state)
  mode=$(omvm mode "$vm_name" 2>/dev/null)
  [[ $mode == local ]] && display="a window on this screen (local)" || display="VNC + Sunshine (remote)"
  if [[ $state == running ]]; then
    gum style \
      --border normal \
      --padding "1 2" \
      --margin "1" \
      --align left \
      "macOS VM Status: RUNNING" \
      "" \
      "Display:   $display" \
      "SSH:       omvm ssh $vm_name" \
      "Settings:  $(setting RAM_GIB 16)G RAM, $(setting CPUS 8) cores" \
      "$(credential_lines | head -1)" \
      "$(credential_lines | tail -1)" \
      "" \
      "To connect: omarchy-macos-vm launch" \
      "To stop:    omarchy-macos-vm stop"
  else
    echo "macOS VM is stopped (status: ${state:-unknown})"
    credential_lines
    echo "To start: omarchy-macos-vm launch"
  fi
  if apple_services_enabled; then
    echo "Apple services: enabled"
  fi
}

case "${1:-}" in
install) shift; install_macos "$@" ;;
create) shift; create_macos "$@" ;;
progress) show_progress ;;
remove) remove_macos "${2:-}" ;;
launch | start) launch_macos "${2:-}" ;;
stop | down) stop_macos ;;
status) status_macos ;;
apple-services)
  shift
  apple_services "$@"
  ;;
help | --help | -h | "") show_usage ;;
*)
  echo "Unknown command: $1" >&2
  echo "" >&2
  show_usage >&2
  exit 1
  ;;
esac
