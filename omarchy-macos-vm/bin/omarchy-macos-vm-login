#!/bin/bash

# omarchy-macos-vm-create.service: at each graphical login until the macOS VM
# exists. Once the restored VM is on VMXFER (or omvm ingest already imported
# it), run `omarchy-macos-vm create --auto` in the background, as a transient
# user unit: it imports the VM, and on linux-aurora-vmapple sets it up and
# defines it, telling the owner in notifications. On the stock kernel it stops
# after the import and asks for one restart (linux-aurora-vmapple is set as the
# persistent default boot entry). Its log: journalctl --user -u omarchy-macos-vm-creating.
# Like the Windows VM install, the progress shows in a floating terminal
# (omarchy-macos-vm progress). omarchy-macos-vm-create.path also runs this
# during a session, when the system side becomes ready after the login.

set -uo pipefail

state_dir=${OMARCHY_MACOS_VM_STATE:-/var/lib/omarchy/macos-vm}
marker=${OMARCHY_MACOS_VM_MARKER:-/etc/omarchy/macos-vm.enabled}
user_state=${XDG_STATE_HOME:-$HOME/.local/state}/omarchy-macos-vm
config_file=${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/macos-vm.conf
images=${OMVM_IMAGES:-${XDG_DATA_HOME:-$HOME/.local/share}/omvm/images}
created=$user_state/vm-created
progress_file=$user_state/progress
stages_file=$user_state/stages
side_kernel=linux-aurora-vmapple
side_kernel_param=${OMARCHY_MACOS_VM_KVM_PARAM:-/sys/module/kvm/parameters/emulate_nisv_ldst}
default_side_kernel=${OMARCHY_MAC_DEFAULT_SIDE_KERNEL:-/etc/omarchy-mac-boot/default-side-kernel}
vm_name=${OMVM_VM:-macos}
unit=omarchy-macos-vm-creating
progress_cmd="omarchy-launch-floating-terminal-with-presentation 'omarchy-macos-vm progress'"
apple_provider=${XDG_CONFIG_HOME:-$HOME/.config}/omvm/apple-services/identity-provider.json
apple_sep_conf=${OMARCHY_MACOS_VM_APPLE_SEP_CONF:-/etc/omvm/sep-identity.conf}

progress_value() { sed -n "s/^$1=//p" "$progress_file" 2>/dev/null | tail -1; }
apple_services_selection() {
  local selected
  case ${OMARCHY_MACOS_VM_APPLE_SERVICES:-} in
    1) echo apple-services; return ;;
    0) echo basic; return ;;
  esac
  selected=$(sed -n 's/^APPLE_SERVICES=//p' "$config_file" 2>/dev/null | tail -1)
  case $selected in
    1) echo apple-services; return ;;
    0) echo basic; return ;;
  esac
  [[ -f $marker ]] || return 0
  python3 -I -c 'import json, sys
try:
    d = json.load(open(sys.argv[1]))
    if d.get("tier") in ("basic", "apple-services"):
        print(d["tier"])
    elif isinstance(d.get("apple_services"), bool):
        print("apple-services" if d["apple_services"] else "basic")
except Exception:
    pass' "$marker" 2>/dev/null
}

apple_services_requested() {
  case $(apple_services_selection) in
    apple-services) return 0 ;;
    basic) return 1 ;;
  esac
  # Imported identity or VM enrollment is a partial legacy Apple-services setup.
  # An installed helper executable or template alone does not request that tier.
  [[ -e $apple_sep_conf || -e $apple_provider || -e $images/vms/$vm_name/apple_services ]]
}

setup_incomplete_or_failed() {
  local pstage stage
  pstage=$(progress_value stage)
  [[ $pstage == ready && -s $stages_file && -s $created ]] || return 0
  for stage in stack credentials ingest kernel setup virt launcher; do
    [[ $(sed -n "s/^$stage=//p" "$stages_file" | tail -1) == ok ]] || return 0
  done
  grep -Eq '=(failed|skipped|pending)$' "$stages_file" && return 0
  if apple_services_requested; then
    [[ $(sed -n 's/^apple_services=//p' "$stages_file" | tail -1) == ok &&
      -e $images/vms/$vm_name/apple_services ]] || return 0
  fi
  return 1
}

# The notification daemon (Omarchy's shell) can come up after this unit: wait
# for it (OMARCHY_MACOS_VM_NOTIFY_WAIT seconds), and log what was sent.
notify() {
  local i wait=${OMARCHY_MACOS_VM_NOTIFY_WAIT:-90}
  for ((i = 0; i < wait; i += 2)); do
    busctl --user status org.freedesktop.Notifications >/dev/null 2>&1 && break
    sleep 2
  done
  echo "notification: $*"
  omarchy-notification-send "$@" 2>/dev/null && return 0
  local args=() a
  for a in "$@"; do [[ $a == --exec ]] && break; args+=("$a"); done
  notify-send "${args[@]}" 2>/dev/null || true
}

if omvm mode "$vm_name" >/dev/null 2>&1; then
  if setup_incomplete_or_failed; then
    detail=$(progress_value detail)
    notify -u critical "macOS VM setup incomplete" \
      "${detail:-A setup step did not complete; run omarchy-macos-vm create to inspect and retry.}" \
      --exec "$progress_cmd"
    exit 1
  fi
  exit 0
fi

ingested=0
compgen -G "$images/*-restore/.ingested" >/dev/null && ingested=1
if ((!ingested)) && [[ ! -e $state_dir/vmxfer-ready ]]; then
  exit 0
fi

if ((ingested)) && [[ ! -e $side_kernel_param ]]; then
  if [[ -f $default_side_kernel ]] && grep -Fxq "$side_kernel" "$default_side_kernel" 2>/dev/null; then
    notify -u critical "macOS VM: restart to finish" \
      "Restart once: Omarchy starts $side_kernel by default and finishes the VM at the next login."
  else
    notify -u critical "macOS VM: restart to finish" \
      "Boot $side_kernel from the Limine menu; the VM is finished at the next login."
  fi
  exit 0
fi

if ! command -v omarchy-macos-vm >/dev/null; then
  notify -u critical -t 0 "macOS VM: finish it" \
    "In a terminal: omvm ingest && omvm setup && omvm virt $vm_name"
  exit 0
fi

if systemctl --user is-active --quiet "$unit.service"; then
  exit 0
fi
systemctl --user reset-failed "$unit.service" 2>/dev/null || true
# create exits 2 when only the restart into the side kernel is left: a wait, not a failure.
systemd-run --user --unit="$unit" --collect --quiet --description="Omarchy: create the macOS VM" \
  --property=SuccessExitStatus=2 "$(command -v omarchy-macos-vm)" create --auto || exit 1
notify "Creating the macOS VM" "Finishing it in the background (10-40 minutes); click to see the progress." --exec "$progress_cmd"
# The progress view, as the Windows VM install shows its own in a terminal.
# Its own unit: this one ends in seconds, and would take the terminal with it.
if [[ -n ${WAYLAND_DISPLAY:-} && -z ${OMARCHY_MACOS_VM_NO_TERMINAL:-} ]]; then
  systemd-run --user --unit=omarchy-macos-vm-progress-view --collect --quiet \
    omarchy-launch-floating-terminal-with-presentation "omarchy-macos-vm progress" ||
    echo "could not open the progress view: omarchy-macos-vm progress" >&2
fi
