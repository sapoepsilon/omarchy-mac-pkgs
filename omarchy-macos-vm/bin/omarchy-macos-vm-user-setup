#!/bin/bash

# omarchy-macos-vm-user.service: once per user, after the system step is done,
# add the "macOS" launcher entry and prepare omvm for this user: its SSH key, the
# pinned guest harness checkout and ~/.config/omvm/gui.env. No guest is created.

set -uo pipefail

state=${XDG_STATE_HOME:-$HOME/.local/state}/omarchy-macos-vm
desktop_file=${XDG_DATA_HOME:-$HOME/.local/share}/applications/macos-vm.desktop

# The same entry omarchy-macos-vm install writes; omvm show where the runtime lacks it.
write_desktop_entry() {
  local exec="omvm show"
  [[ -e $desktop_file ]] && return 0
  command -v omarchy-macos-vm >/dev/null && exec="uwsm app -- omarchy-macos-vm launch"
  mkdir -p "${desktop_file%/*}" &&
    printf '%s\n' "[Desktop Entry]" "Name=macOS" \
      "Comment=Start the macOS VM (omvm) and bring its window to the front" \
      "Exec=$exec" "Icon=macos" "Terminal=false" "Type=Application" \
      "Categories=System;Virtualization;" "Keywords=omvm;macOS;VM;" >"$desktop_file"
}

mkdir -p "$state"
write_desktop_entry || echo "omarchy-macos-vm-user-setup: could not write $desktop_file" >&2
if omvm prepare; then
  omvm doctor || echo "omarchy-macos-vm-user-setup: omvm doctor lists what is still to do" >&2
  date -u +%FT%TZ >"$state/done"
  echo "omarchy-macos-vm-user-setup: omvm is ready; next steps: /var/lib/omarchy/macos-vm/next-steps.txt"
else
  echo "omarchy-macos-vm-user-setup: omvm prepare failed; it runs again at the next login" >&2
  exit 1
fi
