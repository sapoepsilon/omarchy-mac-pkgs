#!/bin/bash

# omarchy-macos-vm-user.service: once per user, after the system step is done,
# add the "macOS" launcher entry and prepare omvm for this user: its SSH key, the
# pinned guest harness checkout and ~/.config/omvm/gui.env. No guest is created.

set -uo pipefail

state=${XDG_STATE_HOME:-$HOME/.local/state}/omarchy-macos-vm
desktop_file=${XDG_DATA_HOME:-$HOME/.local/share}/applications/macos-vm.desktop

# The same entry omarchy-macos-vm install writes; omvm show where the runtime lacks it.
verify_desktop_entry() {
  [[ -f $desktop_file && -s $desktop_file ]] &&
    grep -Fqx '[Desktop Entry]' "$desktop_file" &&
    grep -Eq '^Name=' "$desktop_file" &&
    grep -Eq '^Exec=' "$desktop_file"
}

write_desktop_entry() {
  local exec="omvm show" tmp
  verify_desktop_entry && return 0
  [[ ! -d $desktop_file ]] || return 1
  command -v omarchy-macos-vm >/dev/null && exec="uwsm app -- omarchy-macos-vm launch"
  mkdir -p "${desktop_file%/*}" || return 1
  tmp=$(mktemp "${desktop_file%/*}/.macos-vm.desktop.XXXXXX") || return 1
  if ! printf '%s\n' "[Desktop Entry]" "Name=macOS" \
    "Comment=Start the macOS VM (omvm) and bring its window to the front" \
    "Exec=$exec" "Icon=macos" "Terminal=false" "Type=Application" \
    "Categories=System;Virtualization;" "Keywords=omvm;macOS;VM;" >"$tmp" ||
    ! mv -fT "$tmp" "$desktop_file"; then
    rm -f "$tmp"
    return 1
  fi
  verify_desktop_entry
}

fail_user_setup() {
  rm -f "$state/done"
  mkdir -p "$state" 2>/dev/null && printf '%s\n' "$1" >"$state/user-setup-error" || true
  echo "omarchy-macos-vm-user-setup: $1" >&2
  exit 1
}

mkdir -p "$state" || fail_user_setup "could not create state directory $state"
write_desktop_entry || fail_user_setup "could not create or verify launcher $desktop_file; retry at next login"
if ! omvm prepare; then
  fail_user_setup "omvm prepare failed; it runs again at the next login"
fi
omvm doctor || echo "omarchy-macos-vm-user-setup: omvm doctor lists what is still to do" >&2
tmp_done=$(mktemp "$state/.done.XXXXXX") || fail_user_setup "could not create temporary done marker in $state"
if ! date -u +%FT%TZ >"$tmp_done" || ! mv -f "$tmp_done" "$state/done"; then
  rm -f "$tmp_done"
  fail_user_setup "could not write $state/done"
fi
rm -f "$state/user-setup-error"
echo "omarchy-macos-vm-user-setup: omvm is ready; next steps: /var/lib/omarchy/macos-vm/next-steps.txt"
