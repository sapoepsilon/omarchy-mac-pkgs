#!/bin/bash

# Hand the installer's macOS VM account to its owner (root; omarchy-macos-vm-setup
# and omarchy-macos-vm-vmxfer run it, so at the latest the boot into the side
# kernel does it, before `omvm setup` creates the account).
#
# omarchy-mac-first-boot copies the installer's macOS username and password
# (ESP omarchy/macos-vm-credentials) into the marker /etc/omarchy/macos-vm.enabled
# as "guest_user"/"guest_password" and makes the marker 0600. This writes them to
# the owner's ~/.config/omarchy/macos-vm-credentials (0600, the owner's; what
# `omarchy-macos-vm create --auto` reads), then drops the password from the
# marker and makes it 0644 again. The owner is the marker's "user", else the
# first account with a UID from 1000 and a home directory. With no owner yet
# (account setup still to come) nothing changes and the next run tries again;
# /var/lib/omarchy/macos-vm/credentials-pending tells create --auto to wait.

set -uo pipefail

root=${OMARCHY_MACOS_VM_ROOT:-}
marker=$root/etc/omarchy/macos-vm.enabled
state_dir=$root/var/lib/omarchy/macos-vm
pending=$state_dir/credentials-pending
passwd_file=${OMARCHY_MACOS_VM_PASSWD:-$root/etc/passwd}

say() { printf 'omarchy-macos-vm-credentials: %s\n' "$*"; }

marker_value() {
  python3 -I -c 'import json, sys
try:
    value = json.load(open(sys.argv[1])).get(sys.argv[2], "")
except Exception:
    value = ""
print(value if isinstance(value, str) else "")' "$marker" "$1" 2>/dev/null || true
}

# NAME UID GID HOME of the owner, or nothing.
owner() {
  local want
  want=$(marker_value user)
  awk -F: -v want="$want" '
    want != "" && $1 == want { print $1, $3, $4, $6; found = 1; exit }
    want == "" && $3 >= 1000 && $3 < 60000 && $6 ~ /^\// && !first { first = $1 " " $3 " " $4 " " $6 }
    END { if (!found && first != "") print first }' "$passwd_file"
}

main() {
  [[ -f $marker ]] || return 0
  local user password name uid gid home dir file tmp d
  password=$(marker_value guest_password)
  if [[ -z $password ]]; then
    rm -f "$pending"
    return 0
  fi
  user=$(marker_value guest_user)
  mkdir -p "$state_dir" && : >"$pending"
  read -r name uid gid home < <(owner) || true
  if [[ -z ${name:-} || ! -d $root$home ]]; then
    say "no owner account yet; the macOS VM credentials stay in $marker until there is one"
    return 0
  fi
  dir=$root$home/.config/omarchy
  file=$dir/macos-vm-credentials
  # Only directories that are missing are made (the owner's); existing ones keep their modes.
  for d in "$root$home/.config" "$dir"; do
    [[ -d $d ]] || install -d -m 0755 -o "$uid" -g "$gid" "$d" || { say "cannot create $d"; return 1; }
  done
  # Root writes in the owner's tree: no symlinks there, so it cannot be steered elsewhere.
  if [[ -L $root$home/.config || -L $dir || -L $file ]]; then
    say "a symlink in $dir; not writing the macOS VM credentials there"
    return 1
  fi
  if [[ -s $file ]]; then
    say "$name already has $file; keeping it"
  else
    tmp=$(mktemp "$dir/.macos-vm-credentials.XXXXXX") || return 1
    chmod 0600 "$tmp"
    printf 'USERNAME=%s\nPASSWORD=%s\n' "${user:-$name}" "$password" >"$tmp" &&
      chown "$uid:$gid" "$tmp" && sync "$tmp" && mv -fT -- "$tmp" "$file" || {
      rm -f -- "$tmp"
      say "cannot write $file"
      return 1
    }
    sync "$dir" || true
  fi
  # The password now lives only in the owner's file.
  python3 -I -c 'import json, os, sys
path = sys.argv[1]
with open(path) as f:
    data = json.load(f)
data.pop("guest_password", None)
tmp = path + ".new"
fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
with os.fdopen(fd, "w") as f:
    json.dump(data, f)
    f.write("\n")
    f.flush()
    os.fsync(f.fileno())
os.chmod(tmp, 0o644)
os.replace(tmp, path)' "$marker" || { say "cannot rewrite $marker"; return 1; }
  rm -f "$pending"
  say "handed the macOS VM account ${user:-$name} to $name ($file)"
}

main "$@"
