#!/bin/bash

# omarchy-macos-vm-vmxfer.service: at boot (and when omarchy-macos-vm install
# asks), look on the VMXFER partition for the restored VM the macOS side left
# there (vmxfer.sha256 and the restore bundle: the developer installer's
# "Set up a macOS VM" step, or omvm's run-on-macos.sh) and keep
# /var/lib/omarchy/macos-vm/vmxfer-ready in step with it.
#
# When the VM is there, VMXFER stays mounted read-only at
# /run/omarchy-macos-vm/vmxfer (the stamp's mount=), so the user's
# `omvm ingest` at login needs no sudo password. Every run also ensures the
# persistent default boot entry stays linux-aurora-vmapple while the macOS VM
# stack is enabled (idempotent, and migrates older oneshot installs). Nothing
# is verified or copied here (omvm ingest does that, as the user).

set -uo pipefail

root=${OMARCHY_MACOS_VM_ROOT:-}
state_dir=$root/var/lib/omarchy/macos-vm
stamp=$state_dir/vmxfer-ready
mnt=${OMARCHY_MACOS_VM_VMXFER_MNT:-/run/omarchy-macos-vm/vmxfer}
boot_default=${OMARCHY_MACOS_VM_BOOT_DEFAULT:-/usr/lib/omarchy-macos-vm/omarchy-macos-vm-boot-default}
users_helper=${OMARCHY_MACOS_VM_USERS:-/usr/lib/omarchy-macos-vm/omarchy-macos-vm-users}
credentials_helper=${OMARCHY_MACOS_VM_CREDENTIALS:-/usr/lib/omarchy-macos-vm/omarchy-macos-vm-credentials}

say() { printf 'omarchy-macos-vm-vmxfer: %s\n' "$*"; }

# Ensure linux-aurora-vmapple stays the persistent default Limine entry while
# the stack is enabled (and clean up any legacy oneshot-boot state).
if [[ -x $boot_default ]]; then
  "$boot_default" enable || say "could not ensure linux-aurora-vmapple is the default boot entry"
fi

# Every boot until it is done: the installer's macOS account to the owner
# (the owner may not have existed when omarchy-macos-vm-setup ran).
if [[ -x $credentials_helper ]]; then
  "$credentials_helper" || say "could not hand over the macOS VM account yet"
fi

device=$(lsblk -rno PATH,LABEL | awk '$2=="VMXFER"{print $1; exit}')
if [[ -z $device ]]; then
  rm -f "$stamp" "$state_dir/vmxfer-error"
  say "no VMXFER partition"
  exit 0
fi

mounted_here=0
if [[ -n ${OMARCHY_MACOS_VM_VMXFER_DIR:-} ]]; then
  dir=$OMARCHY_MACOS_VM_VMXFER_DIR
else
  dir=$(findmnt -rno TARGET "$device" | head -1)
  if [[ -z $dir ]]; then
    # Read-only; files readable by every user (omvm ingest runs as the owner).
    mkdir -p "$mnt" && mount -t exfat -o ro,nosuid,nodev,noexec,fmask=0133,dmask=0022 "$device" "$mnt" || {
      rm -f "$stamp"
      mkdir -p "$state_dir" 2>/dev/null && printf 'cannot mount %s read-only\n' "$device" >"$state_dir/vmxfer-error" || true
      say "cannot mount $device read-only" >&2
      exit 1
    }
    dir=$mnt
    mounted_here=1
  fi
fi

if [[ -f $dir/vmxfer.sha256 ]] && compgen -G "$dir/*-restore.tar.gz" >/dev/null; then
  if ! mkdir -p "$state_dir" ||
    ! printf 'device=%s\nmount=%s\nfound=%s\n' "$device" "$dir" "$(date -u +%FT%TZ)" >"$stamp.new" ||
    ! mv -f "$stamp.new" "$stamp"; then
    rm -f "$stamp.new" "$stamp"
    say "cannot write $stamp" >&2
    ((mounted_here)) && umount "$mnt" || true
    exit 1
  fi
  rm -f "$state_dir/vmxfer-error"
  say "the restored macOS VM is on $device ($dir): it is finished at the next login"
  # Whoever is logged in starts the import now (omarchy-macos-vm-create.service).
  [[ -x $users_helper ]] && "$users_helper" kick
  exit 0
fi

rm -f "$stamp" "$state_dir/vmxfer-error"
say "$device has no restored VM yet"
((mounted_here)) && umount "$mnt"
exit 0
