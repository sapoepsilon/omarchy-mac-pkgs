#!/bin/bash

# omarchy-macos-vm-oneshot-boot arm|restore: boot linux-aurora-vmapple once,
# by itself, so the macOS VM can be finished without the owner picking it in
# the Limine menu (omvm setup needs that kernel's KVM patches).
#
# arm (omarchy-macos-vm-vmxfer.service, once the restored VM is on VMXFER):
# point limine.conf's default_entry at the side kernel's entry and remember
# what it was. restore (omarchy-macos-vm-oneshot-restore.service, early on the
# next boot, whichever kernel booted): put default_entry back, unless
# something regenerated limine.conf in between (then it is already back).
# Only the one line changes; linux-aurora stays the default everywhere else,
# and nothing reboots. At most two tries; after that, the Limine menu.

set -uo pipefail

root=${OMARCHY_MACOS_VM_ROOT:-}
state_dir=$root/var/lib/omarchy/macos-vm
esp=${OMARCHY_ESP:-/boot/efi}
conf=$esp/limine.conf
armed=$state_dir/oneshot-armed
tries_file=$state_dir/oneshot-tries
max_tries=${OMARCHY_MACOS_VM_ONESHOT_TRIES:-2}
side_kernel=linux-aurora-vmapple
side_kernel_param=${OMARCHY_MACOS_VM_KVM_PARAM:-/sys/module/kvm/parameters/emulate_nisv_ldst}
homes=${OMARCHY_MACOS_VM_HOMES:-$root/home}

say() { printf 'omarchy-macos-vm-oneshot-boot: %s\n' "$*"; }

# Limine numbers its entries in menu order, directories included: the side
# kernel's position among the lines that open an entry ("/", "//", "///"...).
entry_number() {
  awk -v want="//$side_kernel" '
    /^[[:space:]]*\// { n++; line = $0; sub(/^[[:space:]]*/, "", line); sub(/[[:space:]]*$/, "", line)
                        if (line == want) { print n; exit } }' "$conf"
}

current_default() { sed -n 's/^default_entry:[[:space:]]*//p' "$conf" | head -1; }

# Rewrites limine.conf beside itself, then renames it over (one FAT rename).
set_default() {
  local value=$1 tmp=$conf.omarchy-macos-vm.new
  if [[ -z $value ]]; then
    sed '/^default_entry:/d' "$conf" >"$tmp"
  elif grep -q '^default_entry:' "$conf"; then
    sed "s/^default_entry:.*/default_entry: $value/" "$conf" >"$tmp"
  else
    { printf 'default_entry: %s\n' "$value"; cat "$conf"; } >"$tmp"
  fi || { rm -f "$tmp"; return 1; }
  [[ -s $tmp ]] || { rm -f "$tmp"; return 1; }
  sync -f "$tmp" 2>/dev/null || true
  mv -f "$tmp" "$conf"
}

arm() {
  local tries number previous
  [[ -e $armed ]] && { say "already armed"; return 0; }
  [[ -e $side_kernel_param ]] && { say "already running $side_kernel"; return 0; }
  if compgen -G "$homes/*/.local/share/omvm/images/*-v1" >/dev/null; then
    say "a macOS VM is already set up; nothing to arm"
    return 0
  fi
  tries=$(cat "$tries_file" 2>/dev/null || echo 0)
  [[ $tries =~ ^[0-9]+$ ]] || tries=0
  if ((tries >= max_tries)); then
    say "$side_kernel was armed $tries times; pick it in the Limine menu instead"
    return 0
  fi
  omarchy-mac-limine-active 2>/dev/null || { say "this Mac does not boot with Limine; pick $side_kernel at boot"; return 0; }
  [[ -f $conf ]] || { say "no $conf"; return 0; }
  number=$(entry_number)
  [[ -n $number ]] || { say "$conf has no $side_kernel entry"; return 0; }
  previous=$(current_default)
  mkdir -p "$state_dir" || return 1
  printf 'previous=%s\nset=%s\narmed=%s\n' "$previous" "$number" "$(date -u +%FT%TZ)" >"$armed.new" &&
    mv -f "$armed.new" "$armed" || return 1
  set_default "$number" || { rm -f "$armed"; say "cannot write $conf"; return 1; }
  echo $((tries + 1)) >"$tries_file"
  say "the next boot starts $side_kernel once (Limine entry $number); restart to finish the macOS VM"
}

restore() {
  local previous set
  [[ -e $armed ]] || return 0
  previous=$(sed -n 's/^previous=//p' "$armed")
  set=$(sed -n 's/^set=//p' "$armed")
  if [[ -f $conf && $(current_default) == "$set" ]]; then
    set_default "$previous" || { say "cannot restore $conf; it keeps booting $side_kernel"; return 1; }
    say "Limine's default entry is ${previous:-the first} again"
  fi
  rm -f "$armed"
}

case ${1:-} in
arm) arm ;;
restore) restore ;;
*) echo "usage: omarchy-macos-vm-oneshot-boot arm|restore" >&2; exit 64 ;;
esac
