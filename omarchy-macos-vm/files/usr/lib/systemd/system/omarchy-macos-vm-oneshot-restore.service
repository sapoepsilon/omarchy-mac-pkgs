# Early on the boot after omarchy-macos-vm-vmxfer.service armed the side
# kernel's one-time boot: put Limine's default entry back (linux-aurora), on
# whichever kernel this boot started.
[Unit]
Description=Omarchy: end the one-time boot of linux-aurora-vmapple
ConditionPathExists=/etc/omarchy/macos-vm.enabled
ConditionPathExists=/var/lib/omarchy/macos-vm/oneshot-armed
RequiresMountsFor=/boot/efi /var/lib
After=local-fs.target
Before=omarchy-macos-vm-vmxfer.service

[Service]
Type=oneshot
Environment=HOME=/root
ExecStart=/usr/lib/omarchy-macos-vm/omarchy-macos-vm-oneshot-boot restore
TimeoutStartSec=2min

[Install]
WantedBy=multi-user.target
